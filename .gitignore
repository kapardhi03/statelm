# Data (raw data and frozen splits stay local; the schema-to-split map is tracked)
data/raw/
# Scrubbed conversation text is still client text: it never gets committed.
data/scrubbed/
data/splits/**
!data/splits/**/
!data/splits/schema_assignment.json

# Run outputs (only configs and metrics are tracked)
runs/**
!runs/**/
!runs/**/metrics.json
!runs/**/config.json
!runs/**/sanity_check.json
!runs/**/per_slot.jsonl

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Personal Claude Code config
CLAUDE.local.md
.claude/settings.local.json

# OS
.DS_Store
