# Data (raw data and frozen splits stay local; the schema-to-split map is tracked)
data/raw/
# Scrubbed conversation text is still client text: it never gets committed.
data/scrubbed/
data/splits/**
!data/splits/**/
!data/splits/schema_assignment.json

# Run outputs (only configs and metrics are tracked)
runs/**
!runs/**/
!runs/**/metrics.json
!runs/**/config.json
!runs/**/sanity_check.json
!runs/**/per_slot.jsonl
# A void marker has to be committable, or the record of a void run lives only on one machine.
!runs/**/VOID.md
# Census and cue-diagnostic figures are counts only, by construction and by test. Tracked on
# Kapardhi's decision of 2026-10-03, for the same reason the void marker is: the v2 and v3
# censuses were reported in a message and nothing tied them to a commit or a corpus, so the
# record had to say its figures rested on a report. A gitignored file would still rest on one.
# Anything else under a run directory stays ignored; test_gitignore.py pins both halves.
!runs/**/census.json
!runs/**/cue_diagnostics.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Personal Claude Code config
CLAUDE.local.md
.claude/settings.local.json

# OS
.DS_Store
.env